@author: DIKSHA
"""
import os
filename = "report.txt"
def count_words():
    if os.path.exists(filename):
        with open(filename, "r") as file:
            content = file.read()
            words = content.split()
            word_count = len(words)
            print(f"The file '{filename}' contains {word_count} words.")
    else:
        print(f"Error: The file '{filename}' was not found.")
count_words()
