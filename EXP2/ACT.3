# A traffic police system checks if a driver is overspeeding. If speed > 60 km/h, show fine MESSAGE200
"""
Created on Mon Mar 23 16:03:46 2026
@author: DIKSHA
"""

speed = float(input("Enter vehicle speed (km/h): "))

# Check if speed exceeds the limit
if speed > 60:
    print("Overspeeding detected! Fine issued.")
else:
    print("Speed within limits. Drive safe.")
