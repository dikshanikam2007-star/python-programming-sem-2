# A bank gives loan approval only if salary ≥ ₹25,000. Print Approved/Rejected.
"""
Created on Mon Mar 23 16:01:57 2026

@author: DIKSHA
"""

# Taking input from the user
salary = int(input("Enter your monthly salary: "))

# Checking the condition
if salary >= 25000:
    print("Approved")
else:
    print("Rejected")
